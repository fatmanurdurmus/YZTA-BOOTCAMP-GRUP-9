# Copy this file to infra/.env and fill in real values before running
# `docker compose -f infra/docker-compose.yml up`. This documents every
# environment variable the CarbonPilot stack needs to run in Docker.

# --- PostgreSQL ---
POSTGRES_DB=carbonpilot
POSTGRES_USER=carbonpilot
POSTGRES_PASSWORD=carbonpilot

# --- Backend ---
GEMINI_API_KEY=
JWT_SECRET=super-secret-key-carbonpilot-bootcamp-2026-very-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=carbonpilot-ai

# --- Frontend ---
# Must be reachable from the browser, not just from inside Docker's network
VITE_API_BASE_URL=http://localhost:8000